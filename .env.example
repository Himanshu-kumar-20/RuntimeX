# ─────────────────────────────────────────────────────────────
# RUNTIMEX ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────────────────────

# Gemini API Key from https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-1.5-flash or gemini-2.0-flash
LLM_MODEL=gemini-1.5-flash

# Server Host & Port (used for local backend startup)
PORT=8000
HOST=127.0.0.1

# Optional Frontend Backend URL Override (leave empty for same-origin Vercel deployment)
# VITE_API_BASE_URL=